# shellcheck shell=bash

# .envrc file of direnv.
# If you use vscode, please use the `direnv` extension.

# Point the Dagger CLI at the shared engine running on this host as a systemd
# service (dagger-engine.service, unix socket). This replaces the old global
# /etc/profile.d/dagger.sh: the runner-host config now travels per-project via
# direnv instead of polluting every login shell.
# (The previous `use flake` line was removed in 517f7a6 "drop nix"; the repo is
# container-based now, so there is no flake.nix to evaluate.)
export _EXPERIMENTAL_DAGGER_RUNNER_HOST="unix:///run/dagger/engine.sock"

# Flutter via FVM — .fvmrc pins the version; fvm use creates .fvm/flutter_sdk.
# This must come after `use flake` so FVM Flutter takes precedence.
PATH_add .fvm/flutter_sdk/bin

PATH_add "$HOME/Android/Sdk/platform-tools"

export DAGGER_NO_NAG=1

# Load variables from .env
dotenv_if_exists
