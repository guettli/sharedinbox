<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: Auto Backup goes to Google Drive. Same rules as
     data_extraction_rules.xml (crypto review, F3): no database, no files. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
