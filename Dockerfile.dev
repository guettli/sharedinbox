# Development and Testing Container for SharedInbox
# Replaces the Nix shell environment.
FROM ghcr.io/cirruslabs/flutter:3.44.0

# Install Linux desktop build and test dependencies, Go, NodeJS, python3, and utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang \
    cmake \
    ninja-build \
    pkg-config \
    libgtk-3-dev \
    liblzma-dev \
    libsecret-1-dev \
    libgcrypt20-dev \
    libjsoncpp-dev \
    sqlite3 \
    libsqlite3-dev \
    libssl-dev \
    iproute2 \
    netcat-openbsd \
    xvfb \
    libosmesa6 \
    libegl1 \
    lld \
    git \
    curl \
    jq \
    python3-pip \
    nodejs \
    npm \
    hugo \
    lcov \
    rsync \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Install Task runner
RUN curl -fsSL https://taskfile.dev/install.sh \
    | sh -s -- -b /usr/local/bin v3.48.0

# Install Dagger CLI
RUN curl -fsSL https://dl.dagger.io/dagger/install.sh \
    | DAGGER_VERSION=0.21.8 BIN_DIR=/usr/local/bin sh

# Install python packages (Play Store API clients + pre-commit)
RUN pip install --break-system-packages --no-cache-dir \
    google-api-python-client \
    google-auth-httplib2 \
    httplib2 \
    pre-commit==4.5.1

# Install acpx CLI globally.
# In agentloop devcontainer mode this image *is* the worker, and agentloop calls
# the acpx baked in here (it injects only its own binary, not acpx). This pin
# must therefore match the acpx version of the agentloop release you run —
# agentloop currently ships acpx 0.13.0 (see its package.json). Bump both
# together; a skew breaks the agent runner.
RUN npm install -g acpx@0.13.0

# Setup user "ci".
# Pin ci to uid 1000 (-o allows sharing it with the base image's `ubuntu` user,
# which already holds 1000). In agentloop devcontainer mode the agent runs as
# ci, and the daemon that pre-creates the shared run directory runs as uid 1000;
# matching uids means ci OWNS the files it writes, so no group-write on the
# shared PVC is needed. Without this, useradd picked 1001 and the worker got
# "permission denied" writing output.json.
RUN useradd -m -o -u 1000 -s /bin/bash ci
USER ci
ENV HOME=/home/ci
ENV PATH=/home/ci/.pub-cache/bin:$PATH

WORKDIR /src
