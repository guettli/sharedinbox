# Development and Testing Container for SharedInbox.
#
# This image is BOTH the local dev container and the agentloop worker image.
#
# Flutter/Dart are intentionally NOT installed here. The repo runs all Flutter
# work through Dagger (`task analyze`, `task test-backend`, ... -> `dagger call
# -m ci ...`), which executes on the remote Dagger engine, not on this host.
# Keeping the ~4.6 GB SDK out makes the image small enough to build and run on
# the memory-constrained agentloop worker node — the full Flutter SDK OOM-killed
# it (envbuilder snapshotting the SDK + `flutter test` compiling on an 8 GB node
# shared with etcd). See AGENTS.md -> "Toolchain".
FROM ubuntu:24.04

# Base CLI tools. agentloop's worker preflight requires a baseline set on PATH
# (agentloop internal/doctor DefaultTools: awk curl fd find gh grep gzip jq ls
# pre-commit rg sed ssh tar). Ubuntu provides awk/find/grep/gzip/ls/sed/tar;
# the rest are installed here. fd-find ships its binary as `fdfind`, so symlink
# it to the `fd` name the preflight looks for; gh needs GitHub's apt repo.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    curl \
    jq \
    ripgrep \
    fd-find \
    python3-pip \
    openssh-client \
    && ln -s "$(command -v fdfind)" /usr/local/bin/fd \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# Task runner — the agent drives everything through `task <target>`.
RUN curl -fsSL https://taskfile.dev/install.sh | sh -s -- -b /usr/local/bin v3.48.0

# Dagger CLI — how all Flutter/Dart/build/test work actually runs (against the
# remote engine, not this host). The pin must equal the engine version;
# Renovate keeps it in sync (see renovate.json customManager).
RUN curl -fsSL https://dl.dagger.io/dagger/install.sh | DAGGER_VERSION=0.21.8 BIN_DIR=/usr/local/bin sh

# pre-commit (project git hooks).
RUN pip install --break-system-packages --no-cache-dir pre-commit==4.5.1

# Node 22 (NodeSource) for acpx — acpx 0.13.0 needs Node >= 22.13; Ubuntu's apt
# `nodejs` is 18, on which acpx crashes ("toSorted is not a function").
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# acpx CLI (the agentloop agent runner). In agentloop devcontainer mode this
# image IS the worker and agentloop calls the acpx baked in here, so this pin
# must match the acpx version of the agentloop release you run (currently
# 0.13.0); Renovate tracks it (renovate.json). A skew breaks the agent runner.
RUN npm install -g acpx@0.13.2

# Flutter / Dart / fvm are intentionally absent (see the header). Install guard
# shims so a stray `flutter …` / `dart …` / `fvm …` fails LOUDLY with a pointer
# to the Dagger-backed task, instead of a confusing "command not found".
RUN for t in flutter dart fvm; do \
      printf '%s\n' \
        '#!/bin/sh' \
        'echo "flutter/dart/fvm are not installed in this worker." >&2' \
        'echo "They run via Dagger on the remote engine. Use e.g.:" >&2' \
        'echo "  task test-backend   # backend tests   (dagger)" >&2' \
        'echo "  task analyze        # dart analyze     (dagger)" >&2' \
        'echo "  task check-fast     # fast checks      (dagger)" >&2' \
        'echo "  task check          # full check       (dagger)" >&2' \
        'echo "See AGENTS.md -> Toolchain." >&2' \
        'exit 127' \
      > "/usr/local/bin/$t" && chmod 0755 "/usr/local/bin/$t"; \
    done

# ci user pinned to uid 1000 so the worker OWNS the files it writes into the
# shared run directory the agentloop daemon (also uid 1000) pre-creates. -o
# shares 1000 with the base's `ubuntu` user. Without this the worker gets
# "permission denied" writing output.json.
RUN useradd -m -o -u 1000 -s /bin/bash ci
USER ci
ENV HOME=/home/ci
ENV PATH=/home/ci/.pub-cache/bin:$PATH
# All Dagger work runs against the REMOTE engine over an SSH tunnel that
# scripts/worker_dagger_tunnel.sh opens on localhost:8080. Baking this here means
# every shell (the agent's separate bash calls included) uses the tunnel once
# it's up, without needing to re-export anything. Harmless until the tunnel
# exists — `dagger` simply cannot connect, which is the intended "run the tunnel
# first" signal.
ENV _EXPERIMENTAL_DAGGER_RUNNER_HOST=tcp://localhost:8080

WORKDIR /src
